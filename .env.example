# Optional. Leave empty to disable privileged note/highlights writes.
PRIVATE_MEMO_ADMIN_PASSCODE=
# Optional secret for highlight interaction identities (otherwise uses R2 secret).
HIGHLIGHT_INTERACTIONS_SECRET=
# R2 object storage credentials. Never prefix secrets with PUBLIC_.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clips
R2_HIGHLIGHTS_KEY=meta/game-highlights.json

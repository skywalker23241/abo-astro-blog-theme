{
  "name": "abo-astro-blog-theme",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@10.15.0",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/toggle-proxy.ts",
    "build": "pnpm run prebuild && astro build && pagefind --site dist",
    "preview": "pagefind --site dist --serve",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "subset-fonts": "tsx scripts/subset-fonts.ts",
    "cache-bookmark-icons": "tsx scripts/cache-bookmark-icons.ts",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "tsx scripts/new-post.ts",
    "update-theme": "tsx scripts/update-theme.ts",
    "test": "tsx --test scripts/new-post.test.ts scripts/game-highlights-r2.test.ts scripts/highlight-interactions.test.ts scripts/highlight-library.test.ts scripts/page-transition.test.ts scripts/site-toast.test.ts scripts/check-para-notes.mjs && tsx scripts/cache-bookmark-icons.ts --test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/netlify": "^6.5.9",
    "@astrojs/sitemap": "^3.5.1",
    "@netlify/blobs": "^10.7.13",
    "@netlify/functions": "^5.3.0",
    "@playform/inline": "^0.1.2",
    "astro-theme-toggle": "^0.7.0",
    "feed": "^5.1.0",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^7.0.1",
    "phosphor-astro": "^2.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "satori": "^0.28.0",
    "sharp": "^0.34.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.0",
    "astro": "^5.13.5",
    "astro-robots-txt": "^1.0.0",
    "canvaskit-wasm": "^0.40.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "subset-font": "^2.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}

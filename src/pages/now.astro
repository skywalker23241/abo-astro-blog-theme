---
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'
import MinimalPageHeader from '@/components/ui/MinimalPageHeader.astro'
import RailLinks from '@/components/layout/RailLinks.astro'

// Replace these examples with your own updates; no external accounts are required.
const sections = [
  { id: 'life', title: '生活', content: '留一点时间阅读、散步，记录日常里值得记住的小事。' },
  { id: 'learning', title: '学习', content: '学习用 Astro 搭建网站，把实践过程整理成文章。' },
  { id: 'projects', title: '项目', content: '整理这个博客，让每一篇笔记都有自己的位置。' }
]
---

<IndexLayout
  title="近况"
  description="最近在做的事情与关注的方向"
  seoTitle={`近况 · ${themeConfig.site.title}`}
>
  <div class="now-page minimal-page">
    <MinimalPageHeader meta="NOW" title="此刻" suffix="近况" metaLabel="最近的生活与学习" />
    {
      sections.map((section, index) => (
        <section id={section.id} class="minimal-index-row" aria-labelledby={`${section.id}-title`}>
          <span class="minimal-index-marker" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="minimal-index-content glass-card">
            <header class="minimal-section-head">
              <h2 id={`${section.id}-title`}>{section.title}</h2>
            </header>
            <p>{section.content}</p>
          </div>
        </section>
      ))
    }
  </div>
  <RailLinks
    slot="rail"
    title="最近在做"
    links={sections.map(({ id, title }) => ({ href: `#${id}`, label: title }))}
  />
</IndexLayout>

<style>
  section {
    margin-bottom: 1.25rem;
    scroll-margin-top: 5rem;
  }
  p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.8;
  }
</style>

---
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'
import InlineHint from '@/components/ui/InlineHint.astro'
import MinimalPageHeader from '@/components/ui/MinimalPageHeader.astro'
import RailLinks from '@/components/layout/RailLinks.astro'
import ArrowRight from 'phosphor-astro/ArrowRight.astro'
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro'
import EnvelopeSimple from 'phosphor-astro/EnvelopeSimple.astro'

const pageTitle = '订阅'
const pageDescription = '通过邮件接收新文章'
---

<IndexLayout
  title={pageTitle}
  description={pageDescription}
  seoTitle={`订阅 · ${themeConfig.site.title}`}
  noindex
>
  <div class="newsletter-page minimal-page">
    <MinimalPageHeader
      meta="01 / RSS"
      title="订阅"
      suffix="邮件与 RSS"
      metaLabel="邮件与 RSS 订阅"
    />

    <section id="email-subscribe" class="subscribe-block minimal-index-row">
      <span class="minimal-index-marker" aria-hidden="true">04</span>
      <div class="subscribe-content minimal-index-content glass-card">
        <div class="subscribe-symbol" aria-hidden="true">
          <EnvelopeSimple width="1.625rem" height="1.625rem" aria-hidden="true" />
        </div>
        <h2>订阅此博客</h2>
        <form
          action="https://buttondown.com/api/emails/embed-subscribe/junbo"
          method="post"
          data-astro-reload
          class="subscribe-form"
        >
          <label for="bd-email">邮箱地址</label>
          <div class="subscribe-controls">
            <input
              type="email"
              name="email"
              id="bd-email"
              placeholder="你的邮箱地址"
              autocomplete="email"
              inputmode="email"
              autocapitalize="off"
              spellcheck="false"
              aria-describedby="subscribe-help"
              required
            />
            <input type="hidden" name="embed" value="1" />
            <button type="submit">
              <span>订阅</span>
              <ArrowRight width="1.0625rem" height="1.0625rem" aria-hidden="true" />
            </button>
          </div>
        </form>
        <p id="subscribe-help" class="subscribe-note">
          <InlineHint>提交后请按提示验证邮箱。</InlineHint>
        </p>
        <a
          class="subscribe-credit"
          href="https://buttondown.com/junbo"
          target="_blank"
          rel="noopener noreferrer"
        >
          <EnvelopeSimple width="0.875rem" height="0.875rem" aria-hidden="true" />
          <span>Powered by buttondown</span>
        </a>
      </div>
      <div id="feed-subscribe" class="feed-subscribe">
        <div class="feed-links">
          <a href="/rss.xml" class="rss-link" target="_blank" rel="noopener noreferrer">
            <span>RSS</span>
            <ArrowUpRight width="1rem" height="1rem" aria-hidden="true" />
          </a>
          <a href="/atom.xml" class="rss-link" target="_blank" rel="noopener noreferrer">
            <span>Atom</span>
            <ArrowUpRight width="1rem" height="1rem" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </div>

  <RailLinks
    slot="rail"
    title="订阅方式"
    links={[
      { href: '#email-subscribe', label: '邮件订阅' },
      { href: '/rss.xml', label: 'RSS Feed' },
      { href: '/atom.xml', label: 'Atom Feed' },
      {
        href: 'https://buttondown.com/junbo/archive/u81f4-u8ba2-u9605-u8005-u7684-u4e00-u5c01-u4fe1/',
        label: '致订阅者的一封信'
      }
    ]}
  />
</IndexLayout>

<style>
  .subscribe-block {
    margin-bottom: 3.75rem;
    scroll-margin-top: 2rem;
  }

  .subscribe-content {
    --card-padding: clamp(1.4rem, 5vw, 2.25rem);
  }

  .subscribe-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.4rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--index-accent) 18%, transparent);
    color: var(--text-primary);
  }

  .subscribe-form label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .subscribe-form {
    margin-top: 1.75rem;
  }

  .subscribe-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem;
    border: 1px solid var(--glass-border);
    border-radius: 0.85rem;
    background: var(--glass-surface-muted);
  }

  .subscribe-controls:focus-within {
    border-color: var(--index-accent);
  }

  input[type='email'] {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 0.65rem 0.6rem;
    border-radius: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 1rem;
  }

  input:focus {
    outline: none;
  }

  input::placeholder {
    color: var(--text-tertiary);
  }

  .subscribe-controls button {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    border: 0;
    background: var(--index-accent);
    color: #1a1a1a;
    font: inherit;
    font-size: 0.85rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.16s ease-out,
      color 0.16s ease-out;
  }

  .subscribe-controls button:hover {
    background: color-mix(in srgb, var(--index-accent) 85%, white);
  }

  .subscribe-controls :global(svg) {
    flex-shrink: 0;
  }

  .rss-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--glass-border-muted);
    border-radius: 0.85rem;
    background: var(--glass-surface-muted);
    color: var(--text-secondary);
    font-size: 0.78rem;
    text-decoration: none;
    transition:
      color 0.16s ease-out,
      background-color 0.16s ease-out;
  }

  .rss-link:hover {
    background: var(--glass-surface-strong);
    color: var(--text-primary);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3.5vw, 1.65rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.035em;
  }

  .subscribe-note {
    margin: 0.8rem 0 1.15rem;
    color: var(--text-secondary);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .subscribe-credit {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 1.25rem 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.68rem;
    line-height: 1.7;
    text-decoration: none;
  }

  .subscribe-credit span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .subscribe-credit :global(svg) {
    flex-shrink: 0;
  }

  .feed-subscribe {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.75rem;
    padding: 0 0.25rem;
    scroll-margin-top: 2rem;
  }

  .feed-links {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 520px) {
    .feed-subscribe {
      justify-content: flex-start;
    }
  }

  :is(button, a):focus-visible {
    outline: 2px solid var(--index-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    button,
    .rss-link {
      transition: none;
    }
  }
</style>

---
import { themeConfig } from '@/config'

import FaviconThemeSwitcher from '@/components/ui/FaviconThemeSwitcher.astro'
import BackToTop from '@/components/ui/BackToTop.astro'
import PageTransition from '@/components/ui/PageTransition.astro'
import FontSizeControl from '@/components/ui/FontSizeControl.astro'
import type { LayoutProps } from '@/types'
import { ClientRouter } from 'astro:transitions'

type Props = LayoutProps

const language = (themeConfig.site.language || 'en-US').replace('_', '-')
const { class: bodyClass } = Astro.props
const enablePageTransitions = bodyClass !== 'highlights-body'
---

<html lang={language} data-blog={enablePageTransitions ? '' : undefined}>
  <head>
    {enablePageTransitions && <ClientRouter />}
    <script is:inline data-astro-rerun>
      try {
        const size = localStorage.getItem('abo-reading-size')
        if (size && ['100', '112.5', '125'].includes(size)) {
          document.documentElement.dataset.readingSize = size
        }
      } catch {
        // Reading controls also work when storage is unavailable.
      }
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass} data-copy-code={themeConfig.post.copyCode ? 'enabled' : 'disabled'}>
    {enablePageTransitions && <PageTransition />}
    <FaviconThemeSwitcher />
    <BackToTop />
    {enablePageTransitions && <FontSizeControl placement="desktop" />}

    <div class="layout-wrapper">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
</style>

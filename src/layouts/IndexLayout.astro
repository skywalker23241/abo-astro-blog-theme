---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import SiteFrame from '@/components/layout/SiteFrame.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { themeConfig } from '@/config'

const { title, description, seoTitle, noindex } = Astro.props
const hasCustomRail = Astro.slots.has('rail')
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead
    title={title}
    description={description}
    seoTitle={seoTitle}
    noindex={noindex}
    slot="head"
  />
  <SiteFrame title={title} description={description}>
    <slot />
    {hasCustomRail && <slot name="rail" slot="rail" />}
    {themeConfig.general.footer && <Footer slot="footer" />}
  </SiteFrame>
</BaseLayout>

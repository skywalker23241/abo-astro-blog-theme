---
import { getNextNavLink, getPreviousNavLink } from '@/lib/navigation'

interface NavLink {
  href: string
  label: string
}

interface Props {
  previousPostLink?: NavLink
  nextPostLink?: NavLink
}

const { previousPostLink, nextPostLink } = Astro.props
const nextLink = getNextNavLink(Astro.url.pathname)
const previousLink = getPreviousNavLink(Astro.url.pathname)
const isPostNav = Boolean(previousPostLink || nextPostLink)
---

<nav class="bottom-nav" aria-label="Page navigation">
  {
    isPostNav ? (
      <div class="bottom-nav-inner post">
        {previousPostLink && (
          <a
            class="bottom-nav-link previous"
            href={previousPostLink.href}
            data-page-direction="previous"
            title={previousPostLink.label}
          >
            <span aria-hidden="true">←</span>
            上一篇
            <span class="post-nav-title">{previousPostLink.label}</span>
          </a>
        )}
        {nextPostLink && (
          <a
            class="bottom-nav-link next"
            href={nextPostLink.href}
            data-page-direction="next"
            title={nextPostLink.label}
          >
            <span class="post-nav-title">{nextPostLink.label}</span>
            下一篇
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    ) : (
      <div class="bottom-nav-inner">
        <a class="bottom-nav-link previous" href={previousLink.href} data-page-direction="previous">
          <span aria-hidden="true">←</span>
          {previousLink.label}
        </a>
        <a class="bottom-nav-link next" href={nextLink.href} data-page-direction="next">
          {nextLink.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )
  }
</nav>

<style>
  .bottom-nav {
    margin: 0 0 1.25rem;
  }

  .bottom-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--reading-width);
    margin: 0 auto;
    border-top: 1px dashed var(--divider-color);
    border-bottom: 1px dashed var(--divider-color);
  }

  .bottom-nav-link {
    display: inline-flex;
    align-items: center;
    flex: 1 1 50%;
    gap: 0.4rem;
    min-width: 0;
    min-height: 2.6rem;
    padding: 0.55rem 0.2rem;
    color: var(--text-primary);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      padding 0.15s ease-out,
      color 0.15s ease-out;
  }

  .bottom-nav-link.previous {
    justify-content: flex-start;
  }

  .bottom-nav-link.next {
    justify-content: flex-end;
  }

  .post-nav-title {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-secondary);
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    transition:
      max-width 0.2s ease-out,
      opacity 0.15s ease-out;
  }

  .bottom-nav-inner.post .bottom-nav-link:hover .post-nav-title,
  .bottom-nav-inner.post .bottom-nav-link:focus-visible .post-nav-title {
    max-width: min(14rem, 42vw);
    opacity: 1;
  }

  .bottom-nav-link + .bottom-nav-link {
    border-left: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
  }

  .bottom-nav-link:hover {
    color: var(--text-secondary);
  }

  .bottom-nav-link.previous:hover {
    padding-left: 0.45rem;
  }

  .bottom-nav-link.next:hover {
    padding-right: 0.45rem;
  }

  .bottom-nav-link:focus-visible {
    outline-offset: 0.2rem;
  }

  @media (max-width: 640px) {
    .bottom-nav {
      margin-bottom: 1rem;
    }

    .bottom-nav-link {
      min-height: 2.45rem;
      padding: 0.5rem 0.15rem;
      font-size: 0.66rem;
    }

    .post-nav-title {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .bottom-nav-link {
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bottom-nav-inner,
    .bottom-nav-link {
      transition: none;
    }
  }
</style>

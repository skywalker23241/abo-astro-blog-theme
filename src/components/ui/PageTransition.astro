---
import SpinnerGap from 'phosphor-astro/SpinnerGap.astro'
---

<div
  class="page-transition"
  data-page-transition
  role="status"
  aria-live="polite"
  aria-hidden="true"
  transition:persist="site-page-transition"
>
  <span class="page-transition__doors" aria-hidden="true">
    <span class="page-transition__door page-transition__door--left"></span>
    <span class="page-transition__door page-transition__door--right"></span>
  </span>
  <span class="page-transition__copy">
    <SpinnerGap
      class="page-transition__spinner"
      width="2.125rem"
      height="2.125rem"
      aria-hidden="true"
    />
    <span class="page-transition__status">页面加载中</span>
  </span>
</div>

<script is:inline>
  ;(function () {
    if (window.__sitePageTransitionInstalled) return
    window.__sitePageTransitionInstalled = true

    let activeAt = 0
    let hideTimer = 0
    let landingTimer = 0
    let landingSafetyTimer = 0
    const minimumVisibleMs = 680
    const landingCloseMs = 720
    const landingOpenMs = 1350

    function getTransition() {
      return document.querySelector('[data-page-transition]')
    }

    function showTransition() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

      const transition = getTransition()
      if (!transition) return

      window.clearTimeout(hideTimer)
      transition.hidden = false
      activeAt = performance.now()
      transition.setAttribute('aria-hidden', 'false')
      transition.classList.add('is-active')
    }

    function resetLandingTransition(transition) {
      window.clearTimeout(landingTimer)
      window.clearTimeout(landingSafetyTimer)
      // Hide before removing landing styles so the generic loader cannot flash during its fade-out.
      if (transition) transition.hidden = true
      transition?.classList.remove('is-active', 'is-landing', 'is-opening')
      transition?.setAttribute('aria-hidden', 'true')
      document.documentElement.classList.remove('is-landing-arrival', 'is-landing-pending')
    }

    function openLandingTransition(transition) {
      document.documentElement.classList.add('is-landing-arrival')
      document.documentElement.classList.remove('is-landing-pending')
      transition.classList.add('is-opening')

      landingTimer = window.setTimeout(function () {
        resetLandingTransition(transition)
      }, landingOpenMs)
    }

    function beginLandingTransition(event) {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !(event.target instanceof Element)
      ) {
        return
      }

      const link = event.target.closest('.welcome-enter[href="/blog/"]')
      if (!link || link.dataset.landingTransitionReady === 'true') return

      const transition = getTransition()
      if (!transition) return

      event.preventDefault()
      event.stopImmediatePropagation()
      link.dataset.landingTransitionReady = 'true'
      window.clearTimeout(hideTimer)
      transition.hidden = false
      activeAt = performance.now()
      transition.setAttribute('aria-hidden', 'false')
      transition.classList.remove('is-opening')
      transition.classList.add('is-landing', 'is-active')

      landingTimer = window.setTimeout(function () {
        link.click()
      }, landingCloseMs)

      landingSafetyTimer = window.setTimeout(function () {
        resetLandingTransition(transition)
      }, 5000)
    }

    function hideTransition(immediate) {
      const transition = getTransition()
      if (!transition) return

      window.clearTimeout(hideTimer)
      const elapsed = activeAt ? performance.now() - activeAt : minimumVisibleMs
      const delay = immediate ? 0 : Math.max(0, minimumVisibleMs - elapsed)

      hideTimer = window.setTimeout(function () {
        transition.classList.remove('is-active')
        transition.setAttribute('aria-hidden', 'true')
        activeAt = 0
      }, delay)
    }

    document.addEventListener('astro:before-preparation', showTransition)
    document.addEventListener('astro:before-swap', function (event) {
      const transition = getTransition()
      if (
        !transition?.classList.contains('is-landing') ||
        transition.classList.contains('is-opening') ||
        event.to.pathname !== '/blog/'
      ) {
        return
      }

      // Prepare the incoming document before its first paint; the doors own this transition.
      event.newDocument.documentElement.classList.add('is-landing-pending')
      event.viewTransition.skipTransition()
    })
    document.addEventListener('astro:page-load', function () {
      const transition = getTransition()
      if (transition?.classList.contains('is-landing')) {
        openLandingTransition(transition)
        return
      }

      hideTransition(false)
    })
    window.addEventListener('pageshow', function () {
      const transition = getTransition()
      if (transition?.classList.contains('is-landing')) resetLandingTransition(transition)
      else hideTransition(true)
    })
    document.addEventListener('click', beginLandingTransition, true)
  })()
</script>

<style is:global>
  .page-transition {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 160ms ease-out,
      visibility 0s linear 160ms;
  }

  .page-transition.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 120ms ease-out,
      visibility 0s;
  }

  .page-transition[hidden] {
    display: none;
  }

  .page-transition__doors {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    visibility: hidden;
  }

  .page-transition__door {
    position: relative;
    background:
      linear-gradient(115deg, var(--glass-sheen), transparent 38%),
      color-mix(in srgb, var(--bg) 94%, var(--index-accent, var(--accent)) 6%);
    box-shadow: 0 0 2rem color-mix(in srgb, var(--text-primary) 10%, transparent);
    will-change: transform;
    transition: transform 720ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .page-transition__door--left {
    border-right: 1px solid var(--glass-border);
    transform: translateX(-102%);
  }

  .page-transition__door--right {
    border-left: 1px solid var(--glass-border);
    transform: translateX(102%);
  }

  .page-transition.is-landing {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .page-transition.is-landing .page-transition__doors {
    visibility: visible;
  }

  .page-transition.is-landing .page-transition__copy {
    display: none;
  }

  .page-transition.is-landing.is-active:not(.is-opening) .page-transition__door {
    transform: translateX(0);
  }

  .page-transition.is-landing.is-opening .page-transition__door--left {
    transform: translateX(-102%);
  }

  .page-transition.is-landing.is-opening .page-transition__door--right {
    transform: translateX(102%);
  }

  html.is-landing-pending .site-main-column {
    opacity: 0;
  }

  html.is-landing-arrival .site-main-column {
    animation: landing-content-reveal 820ms 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (min-width: 1180px) {
    html.is-landing-pending :is(.site-sidebar, .site-rail) {
      opacity: 0;
    }

    html.is-landing-arrival .site-sidebar {
      animation: landing-sidebar-left 1100ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    html.is-landing-arrival .site-rail {
      animation: landing-sidebar-right 1100ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  .page-transition__copy {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    padding: 1rem 1.25rem;
    color: var(--text-primary);
  }

  .page-transition__spinner {
    transform-box: fill-box;
    transform-origin: center;
    animation: page-transition-spin 760ms linear infinite;
    will-change: transform;
  }

  .page-transition__status {
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  @keyframes page-transition-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes landing-content-reveal {
    from {
      opacity: 0;
      transform: scale(0.975);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes landing-sidebar-left {
    from {
      opacity: 0;
      transform: translateX(clamp(7rem, 12vw, 13rem));
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes landing-sidebar-right {
    from {
      opacity: 0;
      transform: translateX(clamp(-13rem, -12vw, -7rem));
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition,
    .page-transition__spinner,
    .page-transition__door,
    html.is-landing-pending :is(.site-sidebar, .site-main-column, .site-rail),
    html.is-landing-arrival .site-sidebar,
    html.is-landing-arrival .site-main-column,
    html.is-landing-arrival .site-rail {
      animation: none;
      transition: none;
    }

    html.is-landing-pending :is(.site-sidebar, .site-main-column, .site-rail) {
      opacity: 1;
    }
  }
</style>

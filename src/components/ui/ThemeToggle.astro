---
import { Toggle } from 'astro-theme-toggle'
import ToggleLeft from 'phosphor-astro/ToggleLeft.astro'
import ToggleRight from 'phosphor-astro/ToggleRight.astro'
---

<Toggle aria-label="切换浅色或深色主题">
  <Fragment slot="icon-light">
    <ToggleLeft width="1.25rem" height="1.25rem" aria-hidden="true" />
  </Fragment>
  <Fragment slot="icon-dark">
    <ToggleRight width="1.25rem" height="1.25rem" aria-hidden="true" />
  </Fragment>
</Toggle>

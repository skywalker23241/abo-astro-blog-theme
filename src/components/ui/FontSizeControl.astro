---
import TextAa from 'phosphor-astro/TextAa.astro'
import InlineHint from '@/components/ui/InlineHint.astro'

interface Props {
  placement: 'desktop' | 'header'
}

const { placement } = Astro.props
const panelId = `font-size-${placement}`
const sizes = [
  { value: '100', label: '默认' },
  { value: '112.5', label: '较大' },
  { value: '125', label: '更大' }
]
---

<div class:list={['font-size-control', placement]} data-font-size-control hidden>
  <button
    type="button"
    class="font-size-toggle"
    popovertarget={panelId}
    aria-label="调节字体大小"
    title="调节字体大小"
  >
    <TextAa width="1.25rem" height="1.25rem" aria-hidden="true" />
  </button>
  <div id={panelId} class="font-size-panel" popover="auto" aria-label="字体大小">
    <p>字体大小</p>
    <div class="font-size-options" role="group" aria-label="选择字体大小">
      {
        sizes.map(({ value, label }) => (
          <button type="button" data-reading-size={value} aria-pressed={value === '100'}>
            {label}
          </button>
        ))
      }
    </div>
    <small><InlineHint>应用于博客页面，自动记住你的选择</InlineHint></small>
  </div>
</div>

<style>
  .font-size-control {
    display: inline-flex;
    color: var(--text-secondary);
  }

  .font-size-control[hidden] {
    display: none;
  }

  .desktop {
    display: none;
  }

  .font-size-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .font-size-toggle:hover {
    color: var(--text-primary);
    background: var(--code-bg);
  }

  .font-size-panel {
    position: fixed;
    inset: calc(4.5rem + env(safe-area-inset-top)) 1rem auto auto;
    box-sizing: border-box;
    width: min(19rem, calc(100% - 2rem));
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    background: var(--bg);
    color: var(--text-primary);
    box-shadow: var(--glass-shadow);
    font-family: var(--sans);
    font-size: 0.875rem;
    opacity: 0;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top right;
    transition:
      opacity 160ms ease,
      transform 180ms ease,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  .font-size-panel:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .font-size-panel:popover-open {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .font-size-panel {
      transition: none;
      transform: none;
    }
  }

  p {
    margin: 0 0 0.75rem;
    font-weight: var(--font-weight-bold);
  }

  .font-size-options {
    display: flex;
    gap: 0.5rem;
  }

  .font-size-options button {
    flex: 1;
    min-height: 44px;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
  }

  .font-size-options button[aria-pressed='true'] {
    border-color: var(--text-primary);
    background: var(--code-bg);
    color: var(--text-primary);
    font-weight: var(--font-weight-bold);
  }

  small {
    display: block;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (min-width: 1180px) {
    .desktop {
      position: fixed;
      top: 1rem;
      right: max(1rem, env(safe-area-inset-right));
      z-index: 30;
      display: inline-flex;
      border: 1px solid var(--glass-border);
      border-radius: 50%;
      background: var(--glass-surface-strong);
      box-shadow: var(--glass-shadow-muted);
    }

    .header {
      display: none;
    }

    .font-size-panel {
      top: 4.5rem;
    }
  }
</style>

<script>
  import '@/scripts/font-size-control'
</script>

---
import ArrowUp from 'phosphor-astro/ArrowUp.astro'
---

<span hidden data-back-to-top-origin></span>
<button class="back-to-top" type="button" aria-label="返回顶部" title="返回顶部">
  <ArrowUp width="1.125rem" height="1.125rem" aria-hidden="true" />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: max(1.5rem, calc((100vw - var(--content-width)) / 2 - 4rem));
    bottom: 1.5rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: linear-gradient(145deg, var(--glass-sheen), transparent 60%), var(--glass-surface);
    color: var(--text-secondary);
    box-shadow: var(--glass-highlight), var(--glass-shadow-muted);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    pointer-events: none;
    transition:
      opacity 0.18s ease-out,
      transform 0.18s ease-out,
      color 0.15s ease-out,
      background-color 0.15s ease-out,
      border-color 0.15s ease-out,
      visibility 0.18s ease-out;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top::before {
    content: '';
    position: absolute;
    inset: -4px;
    padding: 2px;
    border-radius: 50%;
    background: conic-gradient(
      var(--index-accent) var(--reading-progress, 0%),
      var(--glass-border) 0
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .back-to-top:hover {
    color: var(--text-primary);
    border-color: var(--index-accent);
    background-color: var(--glass-surface-strong);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--index-accent);
    outline-offset: 4px;
  }

  .back-to-top.is-docked {
    position: relative;
    inset: auto;
    flex-shrink: 0;
  }

  @media (min-width: 1180px) {
    .back-to-top.is-article {
      right: var(--btt-article-right, 1.5rem);
      bottom: calc(1.5rem + var(--btt-lift, 0px));
    }
  }

  /* Without a desktop rail the button sits inside the content column and could cover
     the footer links, so ride above the footer via --btt-lift (set by JS). */
  @media (max-width: 1179px) {
    .back-to-top {
      bottom: calc(1.5rem + var(--btt-lift, 0px));
    }
  }

  @media (max-width: 768px) {
    .back-to-top {
      right: 1.25rem;
      bottom: calc(1.25rem + var(--btt-lift, 0px));
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    const state = (window.__backToTopState ||= {
      installed: false
    })

    function setupBackToTop() {
      if (document.readyState === 'loading') return
      const button = document.querySelector('.back-to-top')
      if (!button) return
      const origin = document.querySelector('[data-back-to-top-origin]')
      const dock = document.querySelector('[data-back-to-top-dock]')
      const article = document.querySelector('.post-main')
      const syncPlacement = () => {
        const docked = !!dock && window.matchMedia('(min-width: 1180px)').matches
        if (docked && button.parentElement !== dock) dock.append(button)
        else if (!docked && origin && button.previousElementSibling !== origin) origin.after(button)
        button.classList.toggle('is-docked', docked)
        button.classList.toggle('is-article', !!article)
        if (article) {
          const right = Math.max(24, window.innerWidth - article.getBoundingClientRect().right + 8)
          button.style.setProperty('--btt-article-right', `${right}px`)
        }
      }
      syncPlacement()
      if (button.dataset.bound === 'true') return
      button.dataset.bound = 'true'

      // This script runs before the footer is parsed, so look it up lazily.
      let footer = null

      const syncVisibility = () => {
        button.classList.toggle('is-visible', window.scrollY > 360)
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight
        const progress =
          scrollableHeight > 0
            ? Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100))
            : 0
        button.style.setProperty('--reading-progress', `${progress}%`)
        const label = `返回顶部（阅读进度 ${Math.round(progress)}%）`
        button.title = label
        button.setAttribute('aria-label', label)
        footer ||= document.querySelector('.site-footer')
        if (footer) {
          const lift = Math.max(0, window.innerHeight - footer.getBoundingClientRect().top)
          button.style.setProperty('--btt-lift', `${Math.round(lift)}px`)
        }
      }

      const scrollToTop = () => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        window.scrollTo({ top: 0, behavior: reducedMotion ? 'instant' : 'smooth' })
      }

      const syncLayout = () => {
        syncPlacement()
        syncVisibility()
      }

      syncVisibility()
      button.addEventListener('click', scrollToTop)
      window.addEventListener('scroll', syncVisibility, { passive: true })
      window.addEventListener('resize', syncLayout)

      document.addEventListener(
        'astro:before-swap',
        () => {
          button.removeEventListener('click', scrollToTop)
          window.removeEventListener('scroll', syncVisibility)
          window.removeEventListener('resize', syncLayout)
          button.dataset.bound = 'false'
        },
        { once: true }
      )
    }

    window.__setupBackToTop = setupBackToTop
    setupBackToTop()

    if (!state.installed) {
      state.installed = true
      document.addEventListener('DOMContentLoaded', setupBackToTop, { once: true })
      document.addEventListener('astro:page-load', setupBackToTop)
    }
  })()
</script>

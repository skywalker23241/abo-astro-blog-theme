---
import { stripCategoryPrefix } from '@/utils/category'
import type { CollectionEntry } from 'astro:content'
import Eye from 'phosphor-astro/Eye.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<section class="popular-posts" data-popular-posts aria-labelledby="popular-posts-title">
  <h2 id="popular-posts-title">热门文章</h2>
  <ol>
    {
      posts.map((post) => (
        <li data-popular-post={post.id} hidden>
          <a href={`/${post.id}/`} data-astro-prefetch="viewport">
            <span class="post-title">
              {post.data.displayTitle || stripCategoryPrefix(post.data.title)}
            </span>
            <span class="post-count">
              <Eye width="0.75rem" height="0.75rem" aria-hidden="true" />
              <span class="sr-only">访问量：</span>
              <span data-popular-count>—</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .popular-posts {
    padding: 1rem;
    border: 1px solid var(--glass-border-muted);
    border-radius: 1.25rem;
    background:
      linear-gradient(145deg, var(--glass-sheen-soft), transparent 44%), var(--glass-surface-muted);
    box-shadow: var(--glass-highlight-muted), var(--glass-shadow-muted);
    backdrop-filter: blur(18px) saturate(112%);
    -webkit-backdrop-filter: blur(18px) saturate(112%);
  }

  h2 {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px dashed var(--divider-color);
  }

  a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.55rem 0;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.6rem;
  }

  a:focus-visible {
    outline: 2px solid var(--index-accent);
    outline-offset: 3px;
  }

  a:hover .post-title,
  a:focus-visible .post-title {
    color: var(--text-primary);
  }

  .post-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s ease-out;
  }

  .post-count {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    color: var(--text-tertiary);
    font-family: var(--mono);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }
</style>

<script is:inline data-astro-rerun>
  ;(function () {
    const root = document.querySelector('[data-popular-posts]')
    if (!root || root.dataset.popularInit === '1') return
    root.dataset.popularInit = '1'

    fetch('/api/post-views')
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data?.views || typeof data.views !== 'object') return
        const entries = Array.from(root.querySelectorAll('[data-popular-post]'))
          .map((item) => ({
            item,
            count: Number(data.views[item.dataset.popularPost] ?? 0)
          }))
          .sort((a, b) => b.count - a.count)

        entries.slice(0, 6).forEach(({ item, count }) => {
          const countElement = item.querySelector('[data-popular-count]')
          if (countElement) countElement.textContent = String(count)
          item.hidden = false
          root.querySelector('ol')?.appendChild(item)
        })
      })
      .catch(() => {})
  })()
</script>

---
import Heart from 'phosphor-astro/Heart.astro'

interface Props {
  slug: string
}

const { slug } = Astro.props
---

<div class="like-widget" data-like-slug={slug} data-pagefind-ignore>
  <div class="like-action">
    <button type="button" class="like-button" aria-label="喜欢这篇文章" aria-pressed="false">
      <Heart class="like-icon" width="1.125rem" height="1.125rem" aria-hidden="true" />
      <span class="like-label">Like</span>
      <span class="like-count" aria-live="polite">·</span>
    </button>
  </div>
</div>

<style>
  .like-widget {
    margin: 3.5rem 0 1.75rem;
    padding: 1.6rem 0 2.5rem;
    display: grid;
    place-items: center;
  }

  .like-action {
    position: relative;
    display: grid;
    place-items: center;
  }

  .like-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.48rem;
    min-width: 8.25rem;
    min-height: 2.65rem;
    padding: 0.58rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.15s ease-out,
      border-color 0.15s ease-out,
      background-color 0.15s ease-out,
      transform 0.15s ease-out;
  }

  .like-button::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--index-accent);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }

  .like-button:hover {
    color: var(--text-primary);
    border-color: var(--index-accent);
    transform: translateY(-0.12rem);
  }

  .like-button:active {
    transform: translateY(0) scale(0.96);
  }

  .like-button.is-liked {
    color: var(--text-primary);
    border-color: var(--index-accent);
    background: color-mix(in srgb, var(--index-accent) 13%, var(--bg));
  }

  .like-button.is-celebrating {
    animation: like-button-bounce 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .like-button.is-celebrating::after {
    animation: like-ring 0.62s ease-out;
  }

  .like-button.is-liked .like-icon {
    fill: currentColor;
    color: var(--index-accent);
  }

  .like-button.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .like-icon {
    flex-shrink: 0;
    transition: transform 0.2s ease-out;
  }

  .like-button.is-liked .like-icon {
    animation: like-pop 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes like-button-bounce {
    0% {
      transform: scale(1);
    }

    35% {
      transform: scale(0.92);
    }

    70% {
      transform: scale(1.06);
    }

    100% {
      transform: scale(1);
    }
  }

  @keyframes like-ring {
    0% {
      opacity: 0.75;
      transform: scale(1);
    }

    100% {
      opacity: 0;
      transform: scale(1.22, 1.55);
    }
  }

  @keyframes like-pop {
    0% {
      transform: scale(1);
    }
    55% {
      transform: scale(1.35) rotate(-8deg);
    }
    100% {
      transform: scale(1);
    }
  }

  .like-count {
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
    min-width: 0.5rem;
  }

  .like-button.is-liked .like-count,
  .like-button:hover .like-count {
    color: var(--text-primary);
  }

  @media (max-width: 520px) {
    .like-widget {
      margin-top: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .like-button.is-celebrating,
    .like-button.is-celebrating::after,
    .like-button.is-liked .like-icon {
      animation: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    const state = (window.__likeButtonState ||= {
      installed: false
    })

    function initLikeWidgets() {
      const widgets = document.querySelectorAll('.like-widget[data-like-slug]')
      widgets.forEach((widget) => {
        if (widget.dataset.likeInit === '1') return
        widget.dataset.likeInit = '1'

        const slug = widget.dataset.likeSlug
        if (!slug) return

        const button = widget.querySelector('.like-button')
        const countEl = widget.querySelector('.like-count')
        if (!button || !countEl) return

        const storageKey = `post-liked:${slug}`
        const liked = localStorage.getItem(storageKey) === '1'
        if (liked) {
          button.classList.add('is-liked')
          button.setAttribute('aria-pressed', 'true')
        }

        const render = (count) => {
          countEl.textContent = count > 0 ? String(count) : '·'
        }

        const animatePress = () => {
          button.classList.remove('is-celebrating')
          void button.offsetWidth
          button.classList.add('is-celebrating')
          window.setTimeout(() => button.classList.remove('is-celebrating'), 650)
        }

        const showThanks = () => {
          document.dispatchEvent(
            new CustomEvent('site:notify', {
              detail: { message: '已点赞，谢谢喜欢。' }
            })
          )
        }

        fetch(`/api/like?slug=${encodeURIComponent(slug)}`)
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            if (data && typeof data.count === 'number') render(data.count)
          })
          .catch(() => {})

        button.addEventListener('click', async () => {
          if (button.classList.contains('is-liked') || button.classList.contains('is-loading'))
            return
          animatePress()
          button.classList.add('is-loading')
          try {
            const res = await fetch('/api/like', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug })
            })
            if (!res.ok) throw new Error('like failed')
            const data = await res.json()
            if (typeof data?.count === 'number') render(data.count)
            localStorage.setItem(storageKey, '1')
            button.classList.add('is-liked')
            button.setAttribute('aria-pressed', 'true')
            showThanks()
          } catch {
            document.dispatchEvent(
              new CustomEvent('site:notify', {
                detail: { message: '点赞失败，请稍后重试。', type: 'error' }
              })
            )
          } finally {
            button.classList.remove('is-loading')
          }
        })
      })
    }

    window.__initLikeWidgets = initLikeWidgets

    if (document.readyState !== 'loading') initLikeWidgets()
    else document.addEventListener('DOMContentLoaded', initLikeWidgets, { once: true })

    if (!state.installed) {
      state.installed = true
      document.addEventListener('astro:page-load', initLikeWidgets)
    }
  })()
</script>

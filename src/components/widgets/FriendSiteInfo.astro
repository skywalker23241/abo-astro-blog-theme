---
import Copy from 'phosphor-astro/Copy.astro'
import InlineHint from '@/components/ui/InlineHint.astro'
import { themeConfig, integrationConfig } from '@/config'

interface Props {
  id: string
}

const { id } = Astro.props
const name = themeConfig.site.title
const url = themeConfig.site.website
const avatar = new URL('/favicon.png', url).href
const description = integrationConfig.profile.tagline
const copyText = `名称：${name}\n网址：${url}\n头像：${avatar}\n简介：${description}`
---

<section
  class="friends-site-info"
  id={id}
  aria-labelledby={`${id}-title`}
  data-copy-text={copyText}
>
  <h2 id={`${id}-title`}>本站信息</h2>
  <div class="site-identity">
    <img src="/favicon.png" width="40" height="40" alt="" loading="lazy" />
    <div><p class="site-name">{name}</p><p class="site-description">{description}</p></div>
  </div>
  <dl>
    <div><dt>网址</dt><dd><a href={url}>{url}</a></dd></div>
    <div>
      <dt>头像地址</dt><dd>
        <a href={avatar} target="_blank" rel="noopener noreferrer">{avatar}</a>
      </dd>
    </div>
  </dl>
  <pre class="friends-copy-text" hidden>{copyText}</pre>
  <button class="friends-copy" type="button">
    <Copy width="1rem" height="1rem" aria-hidden="true" />
    <span data-copy-label>复制友链信息</span>
  </button>
  <p class="exchange-note">
    <InlineHint>欢迎交换友链，<a href="#friends-comments-title">在评论区留言</a>。</InlineHint>
  </p>
</section>

<style>
  .friends-site-info {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--glass-border-muted);
    border-radius: 1.25rem;
    background:
      linear-gradient(145deg, var(--glass-sheen-soft), transparent 44%), var(--glass-surface-muted);
    box-shadow: var(--glass-highlight-muted), var(--glass-shadow-muted);
    backdrop-filter: blur(18px) saturate(112%);
    -webkit-backdrop-filter: blur(18px) saturate(112%);
    scroll-margin-top: 6rem;
  }
  h2 {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .site-identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }
  .site-identity > div {
    min-width: 0;
  }
  img {
    flex: none;
    border-radius: 0.75rem;
    border: 1px solid var(--glass-border-muted);
  }
  p {
    margin: 0;
  }
  .site-name {
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .site-description {
    margin-top: 0.3rem;
    color: var(--text-secondary);
    font-size: 0.68rem;
    line-height: 1.65;
  }
  dl {
    display: grid;
    gap: 0.85rem;
    margin: 1rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--divider-color);
  }
  dt {
    margin-bottom: 0.25rem;
    color: var(--text-tertiary);
    font-size: 0.65rem;
  }
  dd {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  pre {
    max-width: 100%;
    margin: 0 0 1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.7rem;
    line-height: 1.8;
  }
  a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  a:hover {
    color: var(--text-primary);
  }
  button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem;
    border: 1px solid var(--glass-border);
    border-radius: 0.85rem;
    background: var(--glass-surface-strong);
    box-shadow: var(--glass-control-highlight);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }
  button:hover {
    background: color-mix(in srgb, var(--index-accent) 10%, var(--glass-surface-strong));
  }
  .exchange-note {
    margin-top: 0.75rem;
    color: var(--text-tertiary);
    font-size: 0.65rem;
    line-height: 1.8;
  }
  .exchange-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :is(button, a):focus-visible {
    outline: 2px solid var(--index-accent);
    outline-offset: 3px;
  }
</style>

---
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import { stripCategoryPrefix } from '@/utils/category'
import type { RelatedPost } from '@/utils/related'

interface Props {
  posts: RelatedPost[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <aside class="related-posts" aria-label="相关文章" data-pagefind-ignore>
      <h2 class="related-title">继续阅读</h2>
      <ul class="related-list">
        {posts.map((post) => (
          <li>
            <a href={`/${post.id}/`} class="related-link glass-card">
              <span class="related-post-title">
                {post.displayTitle || stripCategoryPrefix(post.title)}
              </span>
              <time class="related-date" datetime={post.pubDate.toISOString()}>
                <FormattedDate date={post.pubDate} format="YYYY-MM-DD" context="list" />
              </time>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-posts {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
  }

  .related-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.65rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: var(--font-weight-regular);
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-list > li {
    margin: 0;
    padding: 0;
  }

  .related-list > li::before {
    content: none;
  }

  .related-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    color: var(--text-primary);
    text-decoration: none;
    box-shadow: var(--glass-highlight), var(--glass-shadow-muted);
    transition:
      color 0.15s ease-out,
      transform 0.15s ease-out;
  }

  .related-link:hover {
    border-color: var(--index-accent);
    box-shadow: var(--glass-highlight), var(--glass-shadow-muted);
  }

  .related-link:hover .related-post-title {
    box-shadow: none;
  }

  .related-post-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .related-date {
    flex-shrink: 0;
    color: var(--text-tertiary);
    font-size: 0.8rem;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease-out;
  }

  .related-link:hover .related-date {
    color: var(--index-accent);
  }

  @media (max-width: 520px) {
    .related-date {
      display: none;
    }
  }
</style>
